{
  "name": "waf2p-website",
  "version": "1.0.0",
  "description": "WAF++ Website with Antora Documentation",
  "scripts": {
    "fetch-rfcs": "node scripts/fetch-rfcs.mjs",
    "copy-assets": "node scripts/copy-local-assets.js",
    "prejekyll:build": "npm run fetch-rfcs && npm run copy-assets",
    "docs:build": "antora antora-playbook.yml",
    "docs:build:local": "antora antora-playbook-local.yml",
    "docs:serve": "antora antora-playbook-local.yml && python3 -m http.server 8000 -d _site",
    "site:build": "npm run fetch-rfcs && npm run copy-assets && bundle exec jekyll build && npm run docs:build:local"
  },
  "keywords": [
    "waf",
    "cloud",
    "architecture",
    "documentation"
  ],
  "author": "WAF++ Community",
  "license": "MIT",
  "devDependencies": {
    "@antora/cli": "^3.1.0",
    "@antora/lunr-extension": "^1.0.0-alpha.13",
    "@antora/pdf-extension": "^1.0.0-rc.4",
    "@antora/site-generator": "^3.1.0",
    "@asciidoctor/tabs": "^1.0.0-beta.6",
    "asciidoctor-kroki": "^0.18.1",
    "asciidoctor-treeview": "^1.0.1",
    "lunr-languages": "^1.14.0"
  },
  "dependencies": {
    "@fontsource/league-spartan": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@highlightjs/cdn-assets": "^11.12.0",
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.5.0",
    "jszip": "^3.10.2",
    "lucide": "^1.59.0",
    "playwright": "^1.63.0"
  }
}
