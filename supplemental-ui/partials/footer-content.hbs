<div id="cookie-consent" class="cookie-consent" role="dialog" aria-modal="true" aria-labelledby="cookie-title" hidden>
  <div class="cookie-consent__overlay" data-cookie-close></div>
  <div class="cookie-consent__card">
    <div class="cookie-consent__header">
      <h2 id="cookie-title" class="cookie-consent__title">Cookie settings</h2>
      <button type="button" class="cookie-consent__close" data-cookie-close aria-label="Close cookie settings">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>

    <div class="cookie-consent__body">
      <p class="cookie-consent__intro">
        We use cookies to keep the site working and, with your consent, to understand how visitors use it. You can change your choices at any time via the floating cookie button.
      </p>

      <div class="cookie-consent__options">
        <label class="cookie-consent__option cookie-consent__option--locked">
          <span class="cookie-consent__switch">
            <input type="checkbox" checked disabled aria-checked="true">
            <span class="cookie-consent__slider"></span>
          </span>
          <span class="cookie-consent__label">
            <strong>Necessary</strong>
            <small>Required for the site to function. Cannot be disabled.</small>
            <span class="cookie-consent__detail">Includes: cookie consent state, theme choice, language, navigation and security tokens.</span>
          </span>
        </label>

        <label class="cookie-consent__option">
          <span class="cookie-consent__switch">
            <input type="checkbox" id="cookie-analytics" data-cookie-category="analytics">
            <span class="cookie-consent__slider"></span>
          </span>
          <span class="cookie-consent__label">
            <strong>Analytics</strong>
            <small>Helps us improve the site by collecting anonymous usage data.</small>
            <span class="cookie-consent__detail">Includes: anonymous page views, referrers, feature usage and device type. No personal identifiers.</span>
          </span>
        </label>

        <label class="cookie-consent__option">
          <span class="cookie-consent__switch">
            <input type="checkbox" id="cookie-functional" data-cookie-category="functional">
            <span class="cookie-consent__slider"></span>
          </span>
          <span class="cookie-consent__label">
            <strong>Functional</strong>
            <small>Remembers your preferences, such as language and theme.</small>
            <span class="cookie-consent__detail">Includes: expanded sections, form drafts, accessibility settings and other convenience choices.</span>
          </span>
        </label>

        <label class="cookie-consent__option">
          <span class="cookie-consent__switch">
            <input type="checkbox" id="cookie-marketing" data-cookie-category="marketing">
            <span class="cookie-consent__slider"></span>
          </span>
          <span class="cookie-consent__label">
            <strong>Marketing</strong>
            <small>Used to measure the success of our outreach.</small>
            <span class="cookie-consent__detail">Includes: campaign link tracking, social referrals and newsletter sign-up attribution.</span>
          </span>
        </label>
      </div>

      <p class="cookie-consent__legal">
        <a href="/legal/">Privacy policy</a>
      </p>
    </div>

    <div class="cookie-consent__actions">
      <button type="button" class="cookie-consent__btn cookie-consent__btn--secondary" data-cookie-reject>
        Necessary only
      </button>
      <button type="button" class="cookie-consent__btn cookie-consent__btn--secondary" data-cookie-save>
        Save preferences
      </button>
      <button type="button" class="cookie-consent__btn cookie-consent__btn--primary" data-cookie-accept>
        Accept all
      </button>
    </div>
  </div>
</div>

<button type="button" class="cookie-consent__trigger" id="cookie-trigger" aria-label="Open cookie settings" title="Open cookie settings">
  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"/><path d="M8.5 8.5v.01"/><path d="M16 15.5v.01"/><path d="M12 12v.01"/><path d="M11 17v.01"/><path d="M7 14v.01"/></svg>
</button>
