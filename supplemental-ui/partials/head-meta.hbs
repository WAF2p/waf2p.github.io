<script>
  /* Old-domain redirect: any waf2p.dev / www.waf2p.dev URL keeps its
     path, query and hash and moves to the canonical Wombat domain. */
  (function () {
    var host = (location.hostname || '').toLowerCase();
    if (host === 'waf2p.dev' || host === 'www.waf2p.dev') {
      location.replace(
        'https://www.wombat-gov.dev' + location.pathname + location.search + location.hash
      );
    }
  })();
</script>
<script>
  (function () {
    try {
      var t = localStorage.getItem('theme');
      if (t === 'dark' || t === 'light') {
        document.documentElement.setAttribute('data-theme', t);
      }
    } catch (e) {}
  })();
</script>
